# R specific
.Rhistory
.Rapp.history
.RData
.Ruserdata
*.Rproj.user/

# R package build artifacts
*.tar.gz
*.Rcheck/

# Output files: everything the pipeline writes is generated, never committed.
# The whole directory is ignored, not just the plot/model extensions, so
# output/model_summary.txt (config.yaml logging.summary_file) stays out too.
output/
*.png
*.rds

# Data files
data/*.xlsx

# IDE
.vscode/
.idea/
*.Rproj

# OS
.DS_Store
Thumbs.db

# Logs
*.log

# Temporary files
*~
\#*\#
.#*

# renv
renv/library/
renv/staging/
renv/python/
renv/.lock
# cc-enforcer index / cc-memory state: machine-local, never content
.ce/
.ccm/
